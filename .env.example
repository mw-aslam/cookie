MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/cookieapp
# Любые длинные случайные строки: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=3000
NODE_ENV=development

# Разрешённые origin для CORS (через запятую)
CORS_ORIGINS=http://localhost:3000

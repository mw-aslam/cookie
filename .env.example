# Скопируйте этот файл в .env и заполните своими значениями.

# ▼▼▼ СЮДА ВСТАВЬТЕ СТРОКУ ПОДКЛЮЧЕНИЯ ИЗ MONGODB ATLAS ▼▼▼
# Atlas → Database → Connect → Drivers → скопируйте строку.
# Замените <password> на пароль пользователя БД, а после ".net/" укажите имя базы (например cookieapp).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/cookieapp?retryWrites=true&w=majority

# Секрет для подписи cookie сессии. Любая длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000

# В продакшене (HTTPS) поставьте production — cookie сессии станет secure.
NODE_ENV=development
